--- a/qapi/misc-i386.json
+++ b/qapi/misc-i386.json
@@ -24,6 +24,35 @@
 { 'command': 'rtc-reset-reinjection' }
 
 ##
+# @x-vmport-guestrpc-send:
+#
+# Send a GuestRPC command to the programs of the guest that listen to
+# the host through the VMware backdoor (TCLO channels), typically the
+# VMware Tools, e.g. "Resolution_Set 1920 1080".  The command is
+# queued for every such program and delivered when it next polls; its
+# result is visible with the trace event vmport_guestrpc_message.
+#
+# Needs the vmport property "guestrpc".
+#
+# @message: the command
+#
+# Features:
+#
+# @unstable: This command is experimental.
+#
