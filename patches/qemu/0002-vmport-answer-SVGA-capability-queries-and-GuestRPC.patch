+++ b/hw/i386/vmport.c
@@ -37,6 +37,9 @@
 #include "system/hw_accel.h"
 #include "system/qtest.h"
 #include "qemu/log.h"
+#include "qemu/guest-random.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc-i386.h"
 #include "trace.h"
 #include "qom/object.h"
 
@@ -56,6 +59,32 @@
 #define VMPORT_COMPAT_CMDS_V2                   \
     (1 << VMPORT_COMPAT_CMDS_V2_BIT)
 
+/*
+ * GuestRPC over CMD_MESSAGE, as in open-vm-tools (lib/message): the
+ * sub-command is in the high word of ECX, the channel in the high word of
+ * EDX, the status is returned in the high word of ECX.
+ */
+#define GUESTRPC_TYPE_OPEN          0
+#define GUESTRPC_TYPE_SENDSIZE      1
+#define GUESTRPC_TYPE_SENDPAYLOAD   2
+#define GUESTRPC_TYPE_RECVSIZE      3
+#define GUESTRPC_TYPE_RECVPAYLOAD   4
+#define GUESTRPC_TYPE_RECVSTATUS    5
+#define GUESTRPC_TYPE_CLOSE         6
+#define GUESTRPC_STATUS_SUCCESS     0x0001
+#define GUESTRPC_STATUS_DORECV      0x0002
+#define GUESTRPC_PROTOCOL_RPCI      0x49435052  /* "RPCI": guest to host */
+#define GUESTRPC_PROTOCOL_TCLO      0x4f4c4354  /* "TCLO": host to guest */
+#define GUESTRPC_FLAG_COOKIE        0x80000000
+#define GUESTRPC_CHANNELS           8
+#define GUESTRPC_MAX_MESSAGE        (64 * 1024)
+#define GUESTRPC_TRACE_CHARS        256
+#define GUESTRPC_MAX_PENDING        32
+#define GUESTINFO_MAX_KEYS          256
+
+/* CMD_GET_SVGA_CAPABILITIES: types answered (ECX high word), see svga_reg.h */
+#define VMPORT_SVGA_CAP_TYPES       4
+
 /* vCPU features reported by CMD_GET_VCPU_INFO */
 #define VCPU_INFO_SLC64_BIT             0
 #define VCPU_INFO_SYNC_VTSCS_BIT        1
@@ -65,6 +94,26 @@
 
 OBJECT_DECLARE_SIMPLE_TYPE(VMPortState, VMPORT)
 
+typedef struct GuestRpcChannel {
+    bool open;
+    bool cookie;
+    /*
+     * TCLO channels carry host commands to the guest: each message the
+     * guest sends is the result of the previous command, and the reply is
+     * the next command queued for it (empty if none).
+     */
+    bool tclo;
+    GQueue *pending;
+    uint32_t cookie_high;
+    uint32_t cookie_low;
+    uint8_t *message;
+    uint32_t message_size;
+    uint32_t message_pos;
+    char *reply;
+    uint32_t reply_size;
+    uint32_t reply_pos;
+} GuestRpcChannel;
+
 struct VMPortState {
     ISADevice parent_obj;
 
@@ -75,6 +124,25 @@
     uint32_t vmware_vmx_version;
     uint8_t vmware_vmx_type;
 
+    /*
+     * Answers to CMD_GET_SVGA_CAPABILITIES, by type: device capabilities,
+     * FIFO capabilities, 3D hardware version, device capabilities 2. They
+     * must match what the SVGA device itself reports, so they come from
+     * the user (or from the device model that launched QEMU).
+     */
+    bool svga_backdoor;
+    uint32_t svga_caps[VMPORT_SVGA_CAP_TYPES];
+
+    bool guestrpc;
+    GuestRpcChannel rpc[GUESTRPC_CHANNELS];
+    /*
+     * Host settings the guest reads with "info-get" (and writes with
+     * "info-set"), like the guestinfo.* entries of a VMware VM: initial
+     * values from the "guestinfo" property, "key=value;key=value".
+     */
+    char *guestinfo;
+    GHashTable *info;
+
     uint32_t compat_flags;
 };
 
@@ -221,6 +289,308 @@
     return ret;
 }
 
+static uint32_t vmport_cmd_get_svga_capabilities(void *opaque, uint32_t addr)
+{
+    X86CPU *cpu = X86_CPU(current_cpu);
+    VMPortState *s = opaque;
+    uint32_t type = (uint32_t)cpu->env.regs[R_ECX] >> 16;
+
+    if (type >= VMPORT_SVGA_CAP_TYPES) {
+        /* Unsupported: EAX = -1 and EBX left unchanged. */
+        trace_vmport_svga_capabilities(type, false, 0);
+        return UINT32_MAX;
+    }
+    trace_vmport_svga_capabilities(type, true, s->svga_caps[type]);
+    cpu->env.regs[R_EBX] = VMPORT_MAGIC;
+    return s->svga_caps[type];
+}
+
+static void guestrpc_clear(GuestRpcChannel *ch)
+{
+    g_free(ch->message);
+    g_free(ch->reply);
+    if (ch->pending) {
+        g_queue_free_full(ch->pending, g_free);
+    }
+    memset(ch, 0, sizeof(*ch));
+}
+
+/* "info-get KEY": the value, or the reply of a VMware host without it. */
+static char *guestinfo_get(VMPortState *s, const char *key)
+{
+    const char *value = g_hash_table_lookup(s->info, key);
+
+    return value ? g_strdup_printf("1 %s", value)
+                 : g_strdup("0 No value found");
+}
+
+/* "info-set KEY VALUE" */
+static char *guestinfo_set(VMPortState *s, const char *args)
+{
+    const char *space = strchr(args, ' ');
+    char *key;
+
+    if (!space || space == args) {
+        return g_strdup("0 Two and exactly two arguments expected");
+    }
+    key = g_strndup(args, space - args);
+    if (g_hash_table_size(s->info) >= GUESTINFO_MAX_KEYS &&
+        !g_hash_table_contains(s->info, key)) {
+        g_free(key);
+        return g_strdup("0 Too many keys");
+    }
+    g_hash_table_replace(s->info, key, g_strdup(space + 1));
+    return g_strdup("1 ");
+}
+
+/*
+ * Host answers to guest commands (RPCI), as a VMware host: the guestinfo
+ * settings, and success for what only informs the host.
+ */
+static char *guestrpc_rpci_reply(VMPortState *s, const char *text,
+                                 uint32_t len)
+{
+    static const struct {
+        const char *prefix;
+        const char *reply;
+    } replies[] = {
+        { "log ", "1 " },
+        { "tools.capability.", "1 " },
+        { "tools.set.version", "1 " },
+        { "guest.log.state", "1 " },
+    };
+    size_t i;
+
+    /* The message is NUL-terminated (see GUESTRPC_TYPE_SENDSIZE). */
+    if (g_str_has_prefix(text, "info-get ")) {
+        return guestinfo_get(s, text + strlen("info-get "));
+    }
+    if (g_str_has_prefix(text, "info-set ")) {
+        return guestinfo_set(s, text + strlen("info-set "));
+    }
+    for (i = 0; i < ARRAY_SIZE(replies); i++) {
+        size_t n = strlen(replies[i].prefix);
+
+        if (len >= n && memcmp(text, replies[i].prefix, n) == 0) {
+            return g_strdup(replies[i].reply);
+        }
+    }
+    return g_strdup("0 Unknown command");
+}
+
+static void guestrpc_set_reply(GuestRpcChannel *ch, const char *reply)
+{
+    g_free(ch->reply);
+    ch->reply = g_strdup(reply);
+    ch->reply_size = strlen(reply);
+    ch->reply_pos = 0;
+}
+
+/*
+ * A complete message. RPCI: trace it and answer like a VMware host (unknown
+ * settings make the guest use its defaults). TCLO: the message is the
+ * result of the previous host command; answer with the next one.
+ */
+static void guestrpc_handle(VMPortState *s, int index, GuestRpcChannel *ch)
+{
+    const char *text = (const char *)ch->message;
+    uint32_t len = ch->message_size;
+
+    if (trace_event_get_state_backends(TRACE_VMPORT_GUESTRPC_MESSAGE)) {
+        g_autofree char *raw = g_strndup(text ? text : "",
+                                         MIN(len, GUESTRPC_TRACE_CHARS));
+        g_autofree char *escaped = g_strescape(raw, NULL);
+        trace_vmport_guestrpc_message(index, escaped);
+    }
+    if (ch->tclo) {
+        g_autofree char *next = ch->pending ? g_queue_pop_head(ch->pending)
+                                            : NULL;
+        guestrpc_set_reply(ch, next ? next : "");
+    } else {
+        g_autofree char *reply = guestrpc_rpci_reply(s, text ? text : "",
+                                                     len);
+
+        guestrpc_set_reply(ch, reply);
+    }
+    trace_vmport_guestrpc_reply(index, ch->reply);
+    g_free(ch->message);
+    ch->message = NULL;
+    ch->message_size = ch->message_pos = 0;
+}
+
+static uint32_t vmport_cmd_message(void *opaque, uint32_t addr)
+{
+    X86CPU *cpu = X86_CPU(current_cpu);
+    CPUX86State *env = &cpu->env;
+    VMPortState *s = opaque;
+    uint32_t type = (uint32_t)env->regs[R_ECX] >> 16;
+    uint32_t ebx = env->regs[R_EBX];
+    uint32_t edx = env->regs[R_EDX];
+    uint32_t index = edx >> 16;
+    uint32_t status = 0;
+    GuestRpcChannel *ch;
+
+    if (type == GUESTRPC_TYPE_OPEN) {
+        bool ok = false;
+        int i = 0;
+
+        uint32_t protocol = ebx & ~GUESTRPC_FLAG_COOKIE;
+
+        if (protocol == GUESTRPC_PROTOCOL_RPCI ||
+            protocol == GUESTRPC_PROTOCOL_TCLO) {
+            for (i = 0; i < GUESTRPC_CHANNELS; i++) {
+                if (!s->rpc[i].open) {
+                    break;
+                }
+            }
+            if (i < GUESTRPC_CHANNELS) {
+                ch = &s->rpc[i];
+                guestrpc_clear(ch);
+                ch->open = true;
+                ch->cookie = ebx & GUESTRPC_FLAG_COOKIE;
+                if (ch->cookie) {
+                    qemu_guest_getrandom_nofail(&ch->cookie_high,
+                                                sizeof(ch->cookie_high));
+                    qemu_guest_getrandom_nofail(&ch->cookie_low,
+                                                sizeof(ch->cookie_low));
+                    env->regs[R_ESI] = ch->cookie_high;
+                    env->regs[R_EDI] = ch->cookie_low;
+                }
+                if (protocol == GUESTRPC_PROTOCOL_TCLO) {
+                    /*
+                     * A VMware host greets every new TCLO channel, then asks
+                     * the program to register its capabilities (the VMware
+                     * Tools only announce them on request).
+                     */
+                    ch->tclo = true;
+                    ch->pending = g_queue_new();
+                    g_queue_push_tail(ch->pending, g_strdup("reset"));
+                    g_queue_push_tail(ch->pending,
+                                      g_strdup("Capabilities_Register"));
+                }
+                env->regs[R_EDX] = (uint32_t)i << 16 | (edx & 0xffff);
+                status = GUESTRPC_STATUS_SUCCESS;
+                ok = true;
+            }
+        }
+        trace_vmport_guestrpc_open(ok ? i : -1, ebx, ok);
+        goto out;
+    }
+
+    if (index >= GUESTRPC_CHANNELS || !s->rpc[index].open) {
+        goto out;
+    }
+    ch = &s->rpc[index];
+    if (ch->cookie && ((uint32_t)env->regs[R_ESI] != ch->cookie_high ||
+                       (uint32_t)env->regs[R_EDI] != ch->cookie_low)) {
+        goto out;
+    }
+
+    switch (type) {
+    case GUESTRPC_TYPE_SENDSIZE:
+        if (ebx > GUESTRPC_MAX_MESSAGE) {
+            break;
+        }
+        g_free(ch->message);
+        ch->message = g_malloc0(ebx + 1);
+        ch->message_size = ebx;
+        ch->message_pos = 0;
+        if (ebx == 0) {
+            guestrpc_handle(s, index, ch);
+        }
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    case GUESTRPC_TYPE_SENDPAYLOAD:
+        if (ch->message && ch->message_pos < ch->message_size) {
+            uint32_t n = MIN(4, ch->message_size - ch->message_pos);
+            uint32_t word = cpu_to_le32(ebx);
+
+            memcpy(ch->message + ch->message_pos, &word, n);
+            ch->message_pos += n;
+            if (ch->message_pos == ch->message_size) {
+                guestrpc_handle(s, index, ch);
+            }
+            status = GUESTRPC_STATUS_SUCCESS;
+        }
+        break;
+    case GUESTRPC_TYPE_RECVSIZE:
+        status = GUESTRPC_STATUS_SUCCESS;
+        if (ch->reply && ch->reply_pos < ch->reply_size) {
+            status |= GUESTRPC_STATUS_DORECV;
+            env->regs[R_EBX] = ch->reply_size - ch->reply_pos;
+            env->regs[R_EDX] = GUESTRPC_TYPE_SENDSIZE << 16 | (edx & 0xffff);
+        }
+        break;
+    case GUESTRPC_TYPE_RECVPAYLOAD:
+        if (ch->reply && ch->reply_pos < ch->reply_size) {
+            uint32_t n = MIN(4, ch->reply_size - ch->reply_pos);
+            uint32_t word = 0;
+
+            memcpy(&word, ch->reply + ch->reply_pos, n);
+            ch->reply_pos += n;
+            env->regs[R_EBX] = le32_to_cpu(word);
+            env->regs[R_EDX] = GUESTRPC_TYPE_SENDPAYLOAD << 16 | (edx & 0xffff);
+            status = GUESTRPC_STATUS_SUCCESS;
+        }
+        break;
+    case GUESTRPC_TYPE_RECVSTATUS:
+        g_free(ch->reply);
+        ch->reply = NULL;
+        ch->reply_size = ch->reply_pos = 0;
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    case GUESTRPC_TYPE_CLOSE:
+        trace_vmport_guestrpc_close(index);
+        guestrpc_clear(ch);
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    default:
+        break;
+    }
+
+out:
+    env->regs[R_ECX] = status << 16;
+    return env->regs[R_EAX];
+}
+
+void qmp_x_vmport_guestrpc_send(const char *message, Error **errp)
+{
+    VMPortState *s = port_state;
+    int i, queued = 0;
+
+    if (!s || !s->guestrpc) {
+        error_setg(errp, "GuestRPC is off (vmport property 'guestrpc')");
+        return;
+    }
+    if (strlen(message) > GUESTRPC_MAX_MESSAGE) {
+        error_setg(errp, "GuestRPC message too long");
+        return;
+    }
+    for (i = 0; i < GUESTRPC_CHANNELS; i++) {
+        GuestRpcChannel *ch = &s->rpc[i];
+
+        if (ch->open && ch->tclo &&
+            g_queue_get_length(ch->pending) < GUESTRPC_MAX_PENDING) {
+            g_queue_push_tail(ch->pending, g_strdup(message));
+            queued++;
+        }
+    }
+    if (!queued) {
+        error_setg(errp, "no guest program listens to GuestRPC "
+                   "(are the VMware Tools running?)");
+    }
+}
+
+static void vmport_reset(DeviceState *dev)
+{
+    VMPortState *s = VMPORT(dev);
+    int i;
+
+    for (i = 0; i < GUESTRPC_CHANNELS; i++) {
+        guestrpc_clear(&s->rpc[i]);
+    }
+}
+
 static const MemoryRegionOps vmport_ops = {
     .read = vmport_ioport_read,
     .write = vmport_ioport_write,
@@ -239,6 +609,27 @@
     memory_region_init_io(&s->io, OBJECT(s), &vmport_ops, s, "vmport", 1);
     isa_register_ioport(isadev, &s->io, 0x5658);
 
+    s->info = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+    if (s->guestinfo) {
+        g_auto(GStrv) items = g_strsplit(s->guestinfo, ";", -1);
+        char **item;
+
+        for (item = items; *item; item++) {
+            const char *equal = strchr(*item, '=');
+
+            if (**item == '\0') {
+                continue;
+            }
+            if (!equal || equal == *item) {
+                error_setg(errp, "vmport: guestinfo entry '%s' is not "
+                           "key=value", *item);
+                return;
+            }
+            g_hash_table_replace(s->info, g_strndup(*item, equal - *item),
+                                 g_strdup(equal + 1));
+        }
+    }
+
     port_state = s;
 
     /* Register some generic port commands */
@@ -250,6 +641,13 @@
         vmport_register(VMPORT_CMD_GET_VCPU_INFO, vmport_cmd_get_vcpu_info,
                         NULL);
     }
+    if (s->svga_backdoor) {
+        vmport_register(VMPORT_CMD_GET_SVGA_CAPABILITIES,
+                        vmport_cmd_get_svga_capabilities, s);
+    }
+    if (s->guestrpc) {
+        vmport_register(VMPORT_CMD_MESSAGE, vmport_cmd_message, s);
+    }
 }
 
