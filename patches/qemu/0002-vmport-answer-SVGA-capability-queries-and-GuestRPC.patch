From: rsvga
Subject: [PATCH] vmport: answer SVGA capability queries, minimal GuestRPC

VMware's SVGA drivers ask the hypervisor for the SVGA device
capabilities through the backdoor before they initialize the device
(BDOOR_CMD_GET_SVGA_CAPABILITIES, command 75, CPL 0 only; the type of
capability is in the high word of ECX, see SVGABackdoorCapType in
svga_reg.h). QEMU does not implement it, so the Windows WDDM driver
assumes a device without 3D and never uses guest-backed objects, command
buffers or screen targets, whatever the device reports.

Add opt-in properties to answer it: "svga-backdoor" enables the command,
"svga-caps", "svga-fifo-caps", "svga-3d-hwversion" and "svga-caps2"
give the answer for each type. On success EBX = BDOOR_MAGIC and EAX =
the value; other types are answered as unsupported (EAX = -1, EBX
unchanged). The values must be those of the SVGA device given to the
guest, typically an out-of-process device model that knows them.

The same drivers log through GuestRPC (BDOOR_CMD_MESSAGE, command 30,
RPCI channel) and read their settings with "info-get guestinfo.*". Add
an opt-in "guestrpc" property with a minimal RPCI implementation:
channels with cookies, the 4-byte send and receive loops of open-vm-tools
(no high-bandwidth port), messages traced by vmport_guestrpc_message,
"log" answered with success, "info-get" with "0 No value found" (what a
VMware host says for an unset key) and everything else with the standard
"0 Unknown command" reply. This makes the driver's own diagnostics
visible: "-trace vmport_guestrpc_message".

Both are off by default: nothing changes for existing configurations.

Tested with QEMU 11.1.2, rsvga and the VMware SVGA WDDM driver 9.17.11
in Windows 11: the driver queries type 0 once at start-up, then logs its
configuration through GuestRPC.

--- a/include/hw/i386/vmport.h
+++ b/include/hw/i386/vmport.h
@@ -13,8 +13,10 @@
     VMPORT_CMD_VMMOUSE_DATA     = 39,
     VMPORT_CMD_VMMOUSE_STATUS   = 40,
     VMPORT_CMD_VMMOUSE_COMMAND  = 41,
+    VMPORT_CMD_MESSAGE          = 30,
     VMPORT_CMD_GETHZ            = 45,
     VMPORT_CMD_GET_VCPU_INFO    = 68,
+    VMPORT_CMD_GET_SVGA_CAPABILITIES = 75,
     VMPORT_ENTRIES
 } VMPortCommand;
 
--- a/hw/i386/trace-events
+++ b/hw/i386/trace-events
@@ -123,6 +123,11 @@
 # vmport.c
 vmport_register(unsigned char command, void *func, void *opaque) "command: 0x%02x func: %p opaque: %p"
 vmport_command(unsigned char command) "command: 0x%02x"
+vmport_svga_capabilities(uint32_t type, bool supported, uint32_t value) "type %u supported %d value 0x%08x"
+vmport_guestrpc_open(int channel, uint32_t protocol, bool ok) "channel %d protocol 0x%08x ok %d"
+vmport_guestrpc_message(int channel, const char *text) "channel %d: %s"
+vmport_guestrpc_reply(int channel, const char *text) "channel %d: %s"
+vmport_guestrpc_close(int channel) "channel %d"
 
 # x86.c
 x86_gsi_interrupt(int irqn, int level) "GSI interrupt #%d level:%d"
--- a/hw/i386/vmport.c
+++ b/hw/i386/vmport.c
@@ -37,6 +37,7 @@
 #include "system/hw_accel.h"
 #include "system/qtest.h"
 #include "qemu/log.h"
+#include "qemu/guest-random.h"
 #include "trace.h"
 #include "qom/object.h"
 
@@ -56,6 +57,29 @@
 #define VMPORT_COMPAT_CMDS_V2                   \
     (1 << VMPORT_COMPAT_CMDS_V2_BIT)
 
+/*
+ * GuestRPC over CMD_MESSAGE, as in open-vm-tools (lib/message): the
+ * sub-command is in the high word of ECX, the channel in the high word of
+ * EDX, the status is returned in the high word of ECX.
+ */
+#define GUESTRPC_TYPE_OPEN          0
+#define GUESTRPC_TYPE_SENDSIZE      1
+#define GUESTRPC_TYPE_SENDPAYLOAD   2
+#define GUESTRPC_TYPE_RECVSIZE      3
+#define GUESTRPC_TYPE_RECVPAYLOAD   4
+#define GUESTRPC_TYPE_RECVSTATUS    5
+#define GUESTRPC_TYPE_CLOSE         6
+#define GUESTRPC_STATUS_SUCCESS     0x0001
+#define GUESTRPC_STATUS_DORECV      0x0002
+#define GUESTRPC_PROTOCOL_RPCI      0x49435052  /* "RPCI": guest to host */
+#define GUESTRPC_FLAG_COOKIE        0x80000000
+#define GUESTRPC_CHANNELS           8
+#define GUESTRPC_MAX_MESSAGE        (64 * 1024)
+#define GUESTRPC_TRACE_CHARS        256
+
+/* CMD_GET_SVGA_CAPABILITIES: types answered (ECX high word), see svga_reg.h */
+#define VMPORT_SVGA_CAP_TYPES       4
+
 /* vCPU features reported by CMD_GET_VCPU_INFO */
 #define VCPU_INFO_SLC64_BIT             0
 #define VCPU_INFO_SYNC_VTSCS_BIT        1
@@ -65,6 +89,19 @@
 
 OBJECT_DECLARE_SIMPLE_TYPE(VMPortState, VMPORT)
 
+typedef struct GuestRpcChannel {
+    bool open;
+    bool cookie;
+    uint32_t cookie_high;
+    uint32_t cookie_low;
+    uint8_t *message;
+    uint32_t message_size;
+    uint32_t message_pos;
+    char *reply;
+    uint32_t reply_size;
+    uint32_t reply_pos;
+} GuestRpcChannel;
+
 struct VMPortState {
     ISADevice parent_obj;
 
@@ -75,6 +112,18 @@
     uint32_t vmware_vmx_version;
     uint8_t vmware_vmx_type;
 
+    /*
+     * Answers to CMD_GET_SVGA_CAPABILITIES, by type: device capabilities,
+     * FIFO capabilities, 3D hardware version, device capabilities 2. They
+     * must match what the SVGA device itself reports, so they come from
+     * the user (or from the device model that launched QEMU).
+     */
+    bool svga_backdoor;
+    uint32_t svga_caps[VMPORT_SVGA_CAP_TYPES];
+
+    bool guestrpc;
+    GuestRpcChannel rpc[GUESTRPC_CHANNELS];
+
     uint32_t compat_flags;
 };
 
@@ -221,6 +270,196 @@
     return ret;
 }
 
+static uint32_t vmport_cmd_get_svga_capabilities(void *opaque, uint32_t addr)
+{
+    X86CPU *cpu = X86_CPU(current_cpu);
+    VMPortState *s = opaque;
+    uint32_t type = (uint32_t)cpu->env.regs[R_ECX] >> 16;
+
+    if (type >= VMPORT_SVGA_CAP_TYPES) {
+        /* Unsupported: EAX = -1 and EBX left unchanged. */
+        trace_vmport_svga_capabilities(type, false, 0);
+        return UINT32_MAX;
+    }
+    trace_vmport_svga_capabilities(type, true, s->svga_caps[type]);
+    cpu->env.regs[R_EBX] = VMPORT_MAGIC;
+    return s->svga_caps[type];
+}
+
+static void guestrpc_clear(GuestRpcChannel *ch)
+{
+    g_free(ch->message);
+    g_free(ch->reply);
+    memset(ch, 0, sizeof(*ch));
+}
+
+static void guestrpc_set_reply(GuestRpcChannel *ch, const char *reply)
+{
+    g_free(ch->reply);
+    ch->reply = g_strdup(reply);
+    ch->reply_size = strlen(reply);
+    ch->reply_pos = 0;
+}
+
+/*
+ * A complete RPCI message: trace it and answer like a VMware host that has
+ * no settings: "log" succeeds, "info-get" finds no value, everything else
+ * is an unknown command. The guest then uses its defaults.
+ */
+static void guestrpc_handle(int index, GuestRpcChannel *ch)
+{
+    const char *text = (const char *)ch->message;
+    uint32_t len = ch->message_size;
+
+    if (trace_event_get_state_backends(TRACE_VMPORT_GUESTRPC_MESSAGE)) {
+        g_autofree char *raw = g_strndup(text ? text : "",
+                                         MIN(len, GUESTRPC_TRACE_CHARS));
+        g_autofree char *escaped = g_strescape(raw, NULL);
+        trace_vmport_guestrpc_message(index, escaped);
+    }
+    if (len >= 4 && memcmp(text, "log ", 4) == 0) {
+        guestrpc_set_reply(ch, "1 ");
+    } else if (len >= 9 && memcmp(text, "info-get ", 9) == 0) {
+        guestrpc_set_reply(ch, "0 No value found");
+    } else {
+        guestrpc_set_reply(ch, "0 Unknown command");
+    }
+    trace_vmport_guestrpc_reply(index, ch->reply);
+    g_free(ch->message);
+    ch->message = NULL;
+    ch->message_size = ch->message_pos = 0;
+}
+
+static uint32_t vmport_cmd_message(void *opaque, uint32_t addr)
+{
+    X86CPU *cpu = X86_CPU(current_cpu);
+    CPUX86State *env = &cpu->env;
+    VMPortState *s = opaque;
+    uint32_t type = (uint32_t)env->regs[R_ECX] >> 16;
+    uint32_t ebx = env->regs[R_EBX];
+    uint32_t edx = env->regs[R_EDX];
+    uint32_t index = edx >> 16;
+    uint32_t status = 0;
+    GuestRpcChannel *ch;
+
+    if (type == GUESTRPC_TYPE_OPEN) {
+        bool ok = false;
+        int i = 0;
+
+        if ((ebx & ~GUESTRPC_FLAG_COOKIE) == GUESTRPC_PROTOCOL_RPCI) {
+            for (i = 0; i < GUESTRPC_CHANNELS; i++) {
+                if (!s->rpc[i].open) {
+                    break;
+                }
+            }
+            if (i < GUESTRPC_CHANNELS) {
+                ch = &s->rpc[i];
+                guestrpc_clear(ch);
+                ch->open = true;
+                ch->cookie = ebx & GUESTRPC_FLAG_COOKIE;
+                if (ch->cookie) {
+                    qemu_guest_getrandom_nofail(&ch->cookie_high,
+                                                sizeof(ch->cookie_high));
+                    qemu_guest_getrandom_nofail(&ch->cookie_low,
+                                                sizeof(ch->cookie_low));
+                    env->regs[R_ESI] = ch->cookie_high;
+                    env->regs[R_EDI] = ch->cookie_low;
+                }
+                env->regs[R_EDX] = (uint32_t)i << 16 | (edx & 0xffff);
+                status = GUESTRPC_STATUS_SUCCESS;
+                ok = true;
+            }
+        }
+        trace_vmport_guestrpc_open(ok ? i : -1, ebx, ok);
+        goto out;
+    }
+
+    if (index >= GUESTRPC_CHANNELS || !s->rpc[index].open) {
+        goto out;
+    }
+    ch = &s->rpc[index];
+    if (ch->cookie && ((uint32_t)env->regs[R_ESI] != ch->cookie_high ||
+                       (uint32_t)env->regs[R_EDI] != ch->cookie_low)) {
+        goto out;
+    }
+
+    switch (type) {
+    case GUESTRPC_TYPE_SENDSIZE:
+        if (ebx > GUESTRPC_MAX_MESSAGE) {
+            break;
+        }
+        g_free(ch->message);
+        ch->message = g_malloc0(ebx + 1);
+        ch->message_size = ebx;
+        ch->message_pos = 0;
+        if (ebx == 0) {
+            guestrpc_handle(index, ch);
+        }
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    case GUESTRPC_TYPE_SENDPAYLOAD:
+        if (ch->message && ch->message_pos < ch->message_size) {
+            uint32_t n = MIN(4, ch->message_size - ch->message_pos);
+            uint32_t word = cpu_to_le32(ebx);
+
+            memcpy(ch->message + ch->message_pos, &word, n);
+            ch->message_pos += n;
+            if (ch->message_pos == ch->message_size) {
+                guestrpc_handle(index, ch);
+            }
+            status = GUESTRPC_STATUS_SUCCESS;
+        }
+        break;
+    case GUESTRPC_TYPE_RECVSIZE:
+        status = GUESTRPC_STATUS_SUCCESS;
+        if (ch->reply && ch->reply_pos < ch->reply_size) {
+            status |= GUESTRPC_STATUS_DORECV;
+            env->regs[R_EBX] = ch->reply_size - ch->reply_pos;
+            env->regs[R_EDX] = GUESTRPC_TYPE_SENDSIZE << 16 | (edx & 0xffff);
+        }
+        break;
+    case GUESTRPC_TYPE_RECVPAYLOAD:
+        if (ch->reply && ch->reply_pos < ch->reply_size) {
+            uint32_t n = MIN(4, ch->reply_size - ch->reply_pos);
+            uint32_t word = 0;
+
+            memcpy(&word, ch->reply + ch->reply_pos, n);
+            ch->reply_pos += n;
+            env->regs[R_EBX] = le32_to_cpu(word);
+            env->regs[R_EDX] = GUESTRPC_TYPE_SENDPAYLOAD << 16 | (edx & 0xffff);
+            status = GUESTRPC_STATUS_SUCCESS;
+        }
+        break;
+    case GUESTRPC_TYPE_RECVSTATUS:
+        g_free(ch->reply);
+        ch->reply = NULL;
+        ch->reply_size = ch->reply_pos = 0;
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    case GUESTRPC_TYPE_CLOSE:
+        trace_vmport_guestrpc_close(index);
+        guestrpc_clear(ch);
+        status = GUESTRPC_STATUS_SUCCESS;
+        break;
+    default:
+        break;
+    }
+
+out:
+    env->regs[R_ECX] = status << 16;
+    return env->regs[R_EAX];
+}
+
+static void vmport_reset(DeviceState *dev)
+{
+    VMPortState *s = VMPORT(dev);
+    int i;
+
+    for (i = 0; i < GUESTRPC_CHANNELS; i++) {
+        guestrpc_clear(&s->rpc[i]);
+    }
+}
+
 static const MemoryRegionOps vmport_ops = {
     .read = vmport_ioport_read,
     .write = vmport_ioport_write,
@@ -250,6 +489,13 @@
         vmport_register(VMPORT_CMD_GET_VCPU_INFO, vmport_cmd_get_vcpu_info,
                         NULL);
     }
+    if (s->svga_backdoor) {
+        vmport_register(VMPORT_CMD_GET_SVGA_CAPABILITIES,
+                        vmport_cmd_get_svga_capabilities, s);
+    }
+    if (s->guestrpc) {
+        vmport_register(VMPORT_CMD_MESSAGE, vmport_cmd_message, s);
+    }
 }
 
 static const Property vmport_properties[] = {
@@ -284,6 +530,23 @@
      * 5 - ACE 1.x (Deprecated)
      */
     DEFINE_PROP_UINT8("vmware-vmx-type", VMPortState, vmware_vmx_type, 2),
+
+    /*
+     * Answer CMD_GET_SVGA_CAPABILITIES, which VMware's SVGA drivers use to
+     * learn the device capabilities before initializing the device. The
+     * values must be those of the SVGA device given to the guest.
+     */
+    DEFINE_PROP_BOOL("svga-backdoor", VMPortState, svga_backdoor, false),
+    DEFINE_PROP_UINT32("svga-caps", VMPortState, svga_caps[0], 0),
+    DEFINE_PROP_UINT32("svga-fifo-caps", VMPortState, svga_caps[1], 0),
+    DEFINE_PROP_UINT32("svga-3d-hwversion", VMPortState, svga_caps[2], 0),
+    DEFINE_PROP_UINT32("svga-caps2", VMPortState, svga_caps[3], 0),
+    /*
+     * Minimal GuestRPC (RPCI channel): messages from the guest are traced
+     * (trace event vmport_guestrpc_message); "log" succeeds, anything else
+     * gets the standard "unknown command" reply.
+     */
+    DEFINE_PROP_BOOL("guestrpc", VMPortState, guestrpc, false),
 };
 
 static void vmport_class_initfn(ObjectClass *klass, const void *data)
@@ -291,6 +554,7 @@
     DeviceClass *dc = DEVICE_CLASS(klass);
 
     dc->realize = vmport_realizefn;
+    device_class_set_legacy_reset(dc, vmport_reset);
     /* Reason: realize sets global port_state */
     dc->user_creatable = false;
     device_class_set_props(dc, vmport_properties);
